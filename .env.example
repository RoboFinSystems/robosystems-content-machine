# =============================================================================
# ROBOSYSTEMS CONTENT MACHINE — Environment Configuration
# =============================================================================
#
# SETUP: cp .env.example .env
#        Then fill in your API keys below.
#
# Nothing here is required to scaffold or author a project. Keys are needed per
# stage: ElevenLabs to voice, OpenAI to make thumbnails, AWS to publish, and the
# YouTube / X keys only when you post.
#
# =============================================================================

# ── ElevenLabs — voice synthesis + the Music API ─────────────────────────────
# Needed by: just voiceover, blog-narrate, music
ELEVEN_LABS_API_KEY=your-elevenlabs-api-key-here
ELEVEN_LABS_VOICE_ID=your-elevenlabs-voice-id

# TTS tuning (all optional — sensible defaults in tools/generate_voiceover_audio.py)
# TTS_MODEL=
# TTS_STABILITY=
# TTS_FORMAT=
# TTS_HTTP_TIMEOUT=
# TTS_GAP_WARN=

# ── OpenAI — thumbnail generation ────────────────────────────────────────────
# Needed by: just thumbnails (prompt model -> image model, ~$0.60 per ticker)
OPENAI_API_KEY=

# ── Pipeline options ─────────────────────────────────────────────────────────
# SUBTITLES: true | false — burn in Whisper-timed captions
SUBTITLES=false
# HTTP_MAX_RETRIES — retry budget for the S3/catalog calls in publish + reindex
# HTTP_MAX_RETRIES=

# ── AWS — S3 artifact store + CloudFront CDN for published content ───────────
# AWS_PROFILE / AWS_REGION drive the aws CLI used by publish and by
# `just infra-deploy` (cloudformation/content.yaml). AWS_S3_BUCKET is the content bucket.
# AWS_CDN_DOMAIN_URL is the public base URL the catalog + briefs are served from: set it to
# the CloudFront custom domain once the content stack is deployed (e.g.
# https://assets.robosystems.ai); leave blank to fall back to
# https://<AWS_S3_BUCKET>.s3.amazonaws.com.
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_CDN_DOMAIN_URL=
# CloudFront distribution id, for cache invalidation on republish. Without it, replacing an
# existing file (e.g. re-voicing a blog narration) serves the OLD copy for up to 24h.
# `just infra-deploy` exports it as the stack's CloudFrontDistributionId output.
AWS_CLOUDFRONT_DISTRIBUTION_ID=
# Route53 hosted zone id for the CDN domain. Optional — `just infra-deploy` auto-resolves it
# from AWS_CDN_DOMAIN_URL's domain; set this only to override (e.g. a delegated subdomain zone).
AWS_ROUTE53_HOSTED_ZONE_ID=

# ── SEC raw-filing store (optional) ──────────────────────────────────────────
# The bucket /collect and /scout pull filing archives from, laid out as
# s3://$SEC_RAW_BUCKET/sec/year={YEAR}/{CIK}/. Read with AWS_PROFILE; separate from the
# content bucket above. Leave blank to fetch filings from EDGAR by hand instead.
SEC_RAW_BUCKET=

# ── YouTube Data + Analytics API ─────────────────────────────────────────────
# Needed by: just yt-upload / yt-publish / yt-short / yt-comment / insights.
# Create an OAuth client (desktop app) in a GCP project with the YouTube Data API v3 and
# YouTube Analytics API enabled, fill in the client id/secret below, then run `just yt-auth`
# once — it walks the browser consent flow and writes YT_REFRESH_TOKEN back into .env for you.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Channel id for `just sync-youtube` (title-matches the channel RSS feed to capture
# video URLs into the research catalog so the portal embeds YouTube).
# Find it: open your channel (e.g. youtube.com/@yourhandle) and grab the "UC..." id from
# the page source / a channel/UC... URL. No API key needed — the feed is public.
YT_CHANNEL_ID=your-youtube-channel-id

# ── X (Twitter) API ──────────────────────────────────────────────────────────
# Needed by: just x-article / x-post / x-short / insights. OAuth 1.0a user context —
# create an app at developer.x.com with read+write, paste all four values below, then
# `just x-auth` to verify them before you post anything.
X_CONSUMER_KEY=
X_SECRET_KEY=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Your handle, without the @ — used to build permalinks for published posts.
X_HANDLE=

# ── Promo codes (optional) ───────────────────────────────────────────────────
# Authored copy carries a literal [PROMO_CODE] placeholder so the real code is never
# committed. Distribution resolves it from here at build time; with nothing configured
# the promo sentence is dropped entirely, so a raw placeholder never ships either way.
# PROMO_CODE overrides both of the others.
PROMO_CODE_DEFAULT=
PROMO_CODE_CANNABIS=
# PROMO_CODE=
